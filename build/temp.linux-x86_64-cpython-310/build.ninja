cxx = c++

cflags = -pthread -B /data/data4/xuhang/miniconda3/envs/oakink2-tamf/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /data/data4/xuhang/miniconda3/envs/oakink2-tamf/include -fPIC -O2 -isystem /data/data4/xuhang/miniconda3/envs/oakink2-tamf/include -fPIC -I/data/data4/xuhang/miniconda3/envs/oakink2-tamf/lib/python3.10/site-packages/numpy/core/include -I/data/data4/xuhang/miniconda3/envs/oakink2-tamf/include/python3.10 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1013"' -DTORCH_EXTENSION_NAME=triangle_hash -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++14
